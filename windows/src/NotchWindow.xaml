<Window x:Class="Navbar.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Navbar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        ShowActivated="False" Focusable="False">
    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="Black" />
        <SolidColorBrush x:Key="FgBrush" Color="White" />
        <SolidColorBrush x:Key="DimBrush" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="FaintBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ChipBrush" Color="#22FFFFFF" />
    </Window.Resources>
    <Grid>
        <Path x:Name="EarLeft" Stretch="Fill" Data="M0,0 L1,0 L1,1 A1,1 0 0 0 0,0 Z" Fill="{DynamicResource BgBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><TranslateTransform x:Name="EarLeftShift" /></Path.RenderTransform>
        </Path>
        <Path x:Name="EarRight" Stretch="Fill" Data="M1,0 L0,0 L0,1 A1,1 0 0 1 1,0 Z" Fill="{DynamicResource BgBrush}"
              HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform><TranslateTransform x:Name="EarRightShift" /></Path.RenderTransform>
        </Path>
        <Border x:Name="Island" Background="{DynamicResource BgBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="0,0,18,18" ClipToBounds="True"
                AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver"
                DragLeave="Island_DragLeave" Drop="Island_Drop"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
            <Grid>
            <!-- Contenu de la pastille fermée : mascotte, heure, musique, minuteur, eau, tâches (au choix) -->
            <StackPanel x:Name="PillContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <local:Watermelon x:Name="MascotPill" VerticalAlignment="Center" />
                <TextBlock x:Name="PillClock" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <StackPanel x:Name="PillMusic" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="PillEq" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="PEq1" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="PEq1S" ScaleY="0.4" /></Border.RenderTransform></Border>
                        <Border x:Name="PEq2" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="PEq2S" ScaleY="0.4" /></Border.RenderTransform></Border>
                        <Border x:Name="PEq3" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="PEq3S" ScaleY="0.4" /></Border.RenderTransform></Border>
                        <Border x:Name="PEq4" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform x:Name="PEq4S" ScaleY="0.4" /></Border.RenderTransform></Border>
                    </StackPanel>
                    <Border x:Name="PillMusicClip" ClipToBounds="True" VerticalAlignment="Center">
                        <Canvas x:Name="PillMusicCanvas">
                            <Canvas x:Name="PillMusicStrip">
                                <Canvas.RenderTransform><TranslateTransform x:Name="PillMusicShift" /></Canvas.RenderTransform>
                                <TextBlock x:Name="PillMusicText" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                                <TextBlock x:Name="PillMusicText2" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" Visibility="Collapsed" />
                            </Canvas>
                        </Canvas>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="PillTimer" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="PillWater" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Emoji" />
                <TextBlock x:Name="PillTasks" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />

                <StackPanel x:Name="PillPrivacy" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse x:Name="DotMic" Fill="#33E07A" Visibility="Collapsed" />
                    <Ellipse x:Name="DotCam" Fill="#33E07A" Visibility="Collapsed" />
                    <Ellipse x:Name="DotScreen" Fill="#FF4646" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="PillWeatherBox" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border x:Name="PillWeatherIcon" VerticalAlignment="Center" />
                    <TextBlock x:Name="PillWeather" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable, Segoe UI" />
                </StackPanel>
                <TextBlock x:Name="PillCalendar" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="PillNote" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PillMeeting" Foreground="#FF5A5A" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="PillMarket" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="PillSys" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="PillBattery" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
            </StackPanel>            <!-- Vue au survol : heure, date, mascotte -->
            <Grid x:Name="HoverPanel" Opacity="0" IsHitTestVisible="False" Margin="26,14,26,14">
              <!-- Date toujours visible en haut, quel que soit le module -->
              <StackPanel x:Name="HeaderBar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock x:Name="HeaderTime" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="HeaderDate" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="HeaderBattery" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <Border x:Name="GearBtn" Background="Transparent" Cursor="Hand" VerticalAlignment="Center" Visibility="Collapsed"
                        ToolTip="Réglages de ce module" MouseLeftButtonUp="Gear_Click" />
              </StackPanel>
<Border x:Name="SearchBoxFrame" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="6" Background="{DynamicResource ChipBrush}">
                    <Grid>
                        <TextBlock x:Name="SearchGlyph" Text="&#xE721;" Foreground="{DynamicResource DimBrush}" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                        <TextBlock x:Name="SearchHint" Text="Rechercher ou commander…" Foreground="{DynamicResource FaintBrush}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" />
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                                 CaretBrush="{DynamicResource FgBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"
                                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseDown"
                                 GotKeyboardFocus="AddBox_GotFocus" LostKeyboardFocus="AddBox_LostFocus"
                                 KeyDown="SearchBox_KeyDown" TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>
              <Grid x:Name="ViewHost">
              <!-- Paroles : la pastille se partage en deux -->
              <ScrollViewer x:Name="LyricsPane" Visibility="Collapsed" HorizontalAlignment="Right" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="LyricsList" />
              </ScrollViewer>
              <!-- Minuteur / Pomodoro -->
              <Grid x:Name="TimerView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Grid x:Name="TimerRingBox">
                            <Border x:Name="TimerRingHost" />
                            <TextBlock x:Name="TimerTimeSmall" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        </Grid>
                        <TextBlock x:Name="TimerLabel2" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed">
                        <TextBlock x:Name="TimerTime" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock x:Name="TimerLabel" Foreground="{DynamicResource DimBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TimerPlayBtn" Text="&#xE768;" Foreground="{DynamicResource FgBrush}" Background="Transparent" Cursor="Hand"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextAlignment="Center"
                                   MouseLeftButtonUp="TimerPlay_Click" />
                        <TextBlock x:Name="TimerStopBtn" Text="&#xE71A;" Foreground="{DynamicResource FgBrush}" Background="Transparent" Cursor="Hand"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextAlignment="Center"
                                   ToolTip="Arrêter" MouseLeftButtonUp="TimerStop_Click" />
                        <TextBlock x:Name="TimerResetBtn" Text="&#xE777;" Foreground="{DynamicResource FgBrush}" Background="Transparent" Cursor="Hand"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextAlignment="Center"
                                   MouseLeftButtonUp="TimerReset_Click" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PresetRow" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" />
              </Grid>
              <!-- Étagère de fichiers -->
              <Grid x:Name="ShelfView" Visibility="Collapsed">
                <Rectangle x:Name="ShelfZone" Stroke="{DynamicResource FaintBrush}" StrokeThickness="1.4" StrokeDashArray="4 3"
                           Fill="{DynamicResource ChipBrush}" Opacity="0.45" IsHitTestVisible="False" />
                <Border x:Name="ShelfClear" Background="{DynamicResource ChipBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Cursor="Hand" Visibility="Collapsed" Panel.ZIndex="3" MouseLeftButtonUp="ShelfClear_Click">
                    <TextBlock x:Name="ShelfClearText" Text="Vider" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                </Border>
                <StackPanel x:Name="ShelfFolders" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="3" />
                <StackPanel x:Name="ShelfShots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="3" />
                <TextBlock x:Name="ShelfHint" Text="Dépose des fichiers ici" Foreground="{DynamicResource FaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable, Segoe UI" />
                <TextBlock x:Name="ShelfCaption" Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Left"
                           VerticalAlignment="Bottom" FontFamily="Segoe UI Variable, Segoe UI" />
                <ScrollViewer x:Name="ShelfScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel x:Name="ShelfItems" Orientation="Horizontal" />
                </ScrollViewer>
              </Grid>
              <!-- Tâches : compteur en anneau, boutons Ajouter / Modifier, liste en pastilles -->
              <Grid x:Name="TasksView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid>
                            <Border x:Name="TaskRingHost" />
                            <TextBlock x:Name="TaskRingText" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TaskTitle" Text="À faire" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                            <TextBlock x:Name="TaskSub" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="TaskAddBtn" Cursor="Hand" MouseLeftButtonUp="TaskAdd_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TaskAddGlyph" Text="&#xE710;" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <TextBlock x:Name="TaskAddText" Text="Ajouter" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="TaskEditBtn" Cursor="Hand" MouseLeftButtonUp="TaskEdit_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TaskEditGlyph" Text="&#xE70F;" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <TextBlock x:Name="TaskEditText" Text="Modifier" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Border x:Name="AddBoxFrame" Grid.Row="1" Background="{DynamicResource ChipBrush}" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="AddBoxHint" Text="Nouvelle tâche…  (@14:30 = rappel)" Foreground="{DynamicResource FaintBrush}" IsHitTestVisible="False"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" />
                        <TextBox x:Name="AddBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                                 CaretBrush="{DynamicResource FgBrush}" VerticalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI"
                                 PreviewMouseLeftButtonDown="AddBox_PreviewMouseDown"
                                 GotKeyboardFocus="AddBox_GotFocus" LostKeyboardFocus="AddBox_LostFocus"
                                 KeyDown="AddBox_KeyDown" TextChanged="AddBox_TextChanged" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="TaskScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="TaskList" />
                </ScrollViewer>
              </Grid>              <!-- Eau -->
              <Grid x:Name="WaterView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="WaterTotal" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" />
                        <TextBlock x:Name="WaterSub" Foreground="{DynamicResource DimBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="WaterUndoBtn" Text="&#xE7A7;" Foreground="{DynamicResource DimBrush}" Background="Transparent" Cursor="Hand"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" TextAlignment="Center" ToolTip="Annuler le dernier ajout"
                                   MouseLeftButtonUp="WaterUndo_Click" />
                        <Border x:Name="WaterSettingsBtn" Background="{DynamicResource ChipBrush}" Cursor="Hand" ToolTip="Réglages de l'eau"
                                MouseLeftButtonUp="WaterSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WaterSettingsGlyph" Text="&#xE713;" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                <TextBlock x:Name="WaterSettingsText" Text="Réglages" Foreground="{DynamicResource FgBrush}" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable, Segoe UI" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="WaterAddBtn" Cursor="Hand" Background="{DynamicResource ChipBrush}" MouseLeftButtonUp="WaterAdd_Click">
                            <TextBlock x:Name="WaterAddText" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                       FontFamily="Segoe UI Variable, Segoe UI" />
                        </Border>
                    </StackPanel>
                </Grid>
                <Border x:Name="WaterTrack" Grid.Row="1" Background="{DynamicResource TrackBrush}">
                    <Border x:Name="WaterFill" HorizontalAlignment="Left" Width="0" />
                </Border>
                <Grid x:Name="WaterChart" Grid.Row="2" />
              </Grid>
              <!-- Météo -->
              <Grid x:Name="WeatherView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="WeatherNow" Grid.Row="0" />
                <UniformGrid x:Name="WeatherDays" Grid.Row="1" Rows="1" VerticalAlignment="Center" />
                <TextBlock x:Name="WeatherExtra" Grid.Row="2" HorizontalAlignment="Center" FontFamily="Segoe UI Variable, Segoe UI" TextWrapping="Wrap" />
                <TextBlock x:Name="WeatherNote" Grid.Row="3" Foreground="{DynamicResource FaintBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                <Border x:Name="WeatherModeBtn" Grid.Row="3" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ChipBrush}" MouseLeftButtonUp="WeatherMode_Click">
                    <TextBlock x:Name="WeatherModeText" Text="Heures" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                </Border>
              </Grid>
<!-- Bourse et crypto -->
              <Grid x:Name="MarketView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="MarketTitle" Text="Bourse" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                        <TextBlock x:Name="MarketNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="MarketAddBtn" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" MouseLeftButtonUp="MarketAdd_Click">
                        <TextBlock x:Name="MarketAddText" Text="+ Ajouter" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                    </Border>
                </Grid>
                <Border x:Name="MarketSearchFrame" Grid.Row="1" Background="{DynamicResource ChipBrush}" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="MarketSearchHint" Text="Nom ou code : tesla, bitcoin, MC.PA…" Foreground="{DynamicResource FaintBrush}"
                                   FontFamily="Segoe UI Variable, Segoe UI" IsHitTestVisible="False" VerticalAlignment="Center" />
                        <TextBox x:Name="MarketSearchBox" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource FgBrush}"
                                 CaretBrush="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center"
                                 PreviewMouseLeftButtonDown="MarketSearchBox_PreviewMouseDown" TextChanged="MarketSearchBox_TextChanged"
                                 GotKeyboardFocus="AddBox_GotFocus" LostKeyboardFocus="AddBox_LostFocus" KeyDown="MarketSearchBox_KeyDown" />
                    </Grid>
                </Border>
                <ScrollViewer x:Name="MarketScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="MarketList" />
                </ScrollViewer>
              </Grid>
              <!-- Discord (vocal) -->
              <Grid x:Name="DiscordView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="DiscordTitle" Text="Discord" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                        <TextBlock x:Name="DiscordNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="DiscordButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ScrollViewer x:Name="DiscordScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="DiscordList" />
                </ScrollViewer>
              </Grid>
              <!-- Maison (Home Assistant) -->
              <Grid x:Name="SmartView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="SmartTitle" Text="Maison" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    <TextBlock x:Name="SmartNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer x:Name="SmartScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="SmartList" />
                </ScrollViewer>
              </Grid>              <!-- Réseau -->
              <Grid x:Name="NetView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="NetTitle" Text="Réseau" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    <TextBlock x:Name="NetNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <Grid x:Name="NetBody" Grid.Row="1" />
              </Grid>              <!-- Agenda (calendriers Home Assistant) -->
              <Grid x:Name="CalView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="CalTitle" Text="Agenda" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    <TextBlock x:Name="CalNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="CalModeBtn" Grid.Row="0" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource ChipBrush}" MouseLeftButtonUp="CalMode_Click">
                    <TextBlock x:Name="CalModeText" Text="Semaine" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                </Border>
                <ScrollViewer x:Name="CalScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="CalList" />
                </ScrollViewer>
              </Grid>              <!-- Fenêtres ouvertes -->
              <Grid x:Name="WinView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="WinTitle" Text="Fenêtres" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                               FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    <TextBlock x:Name="WinNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer x:Name="WinScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="WinList" />
                </ScrollViewer>
              </Grid>              <!-- Chat IA -->
              <Grid x:Name="ChatView" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatTitle" Text="Chat IA" Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                                   FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChatNote" Foreground="{DynamicResource DimBrush}" FontFamily="Segoe UI Variable, Segoe UI" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ChatModelBtn" Cursor="Hand" MouseLeftButtonUp="ChatModel_Click">
                            <TextBlock x:Name="ChatModelText" Text="Modèle" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                        </Border>
                        <Border x:Name="ChatHistBtn" Cursor="Hand" MouseLeftButtonUp="ChatHist_Click">
                            <TextBlock x:Name="ChatHistText" Text="Historique" Foreground="{DynamicResource FgBrush}" FontFamily="Segoe UI Variable, Segoe UI" />
                        </Border>
                        <Border x:Name="ChatNewBtn" Cursor="Hand" MouseLeftButtonUp="ChatNew_Click">
